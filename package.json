{
  "name": "neofoot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:ocr": "vitest run --project ocr",
    "test:all": "vitest run",
    "verify:deploy": "node scripts/check-deployment.mjs",
    "verify:phase": "node scripts/verify-phase-08.1.mjs",
    "verify:schema": "node scripts/verify-schema.mjs",
    "migrations:manifest": "node scripts/build-migration-manifest.mjs",
    "migrations:check": "node scripts/build-migration-manifest.mjs --check",
    "pwa:icons": "node scripts/build-pwa-icons.mjs",
    "preview": "vite preview",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "predev": "npm run ocr:assets",
    "prebuild": "npm run ocr:assets",
    "ocr:spike": "node scripts/ocr-spike.mjs",
    "ocr:spike:self-test": "node scripts/ocr-spike.mjs --self-test",
    "ocr:spike:info": "node scripts/ocr-spike.mjs --info",
    "lineup:check": "npx vite build --config scripts/lineup-render-check/vite.config.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
